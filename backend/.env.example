APP_NAME=RedPA AI
APP_VERSION=19.1.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOWED_HEADERS=["*"]
CORS_EXPOSED_HEADERS=["X-Request-ID","X-Process-Time-Ms"]
CORS_ALLOW_CREDENTIALS=true

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=redpa_ai
DATABASE_USER=postgres
DATABASE_PASSWORD=123456
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Production Agentic AI / multi-provider gateway
MODEL_GATEWAY_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MODEL_GATEWAY_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MODEL_GATEWAY_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_GATEWAY_FALLBACK_PROVIDERS=
MODEL_GATEWAY_ECONOMICS_JSON=
