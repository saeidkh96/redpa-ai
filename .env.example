APP_NAME=RedPA AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
JSON_LOGS=true

API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/redpa_ai
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

SECRET_KEY=replace-with-a-long-random-secret
API_KEY_PEPPER=replace-with-a-random-pepper
ACCESS_TOKEN_EXPIRE_MINUTES=60

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
TEMPO_URL=http://tempo:3200
OTEL_COLLECTOR_HEALTH_URL=http://otel-collector:13133

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400

BACKGROUND_WORKER_POLL_SECONDS=2
BACKGROUND_WORKER_CONCURRENCY=4

SLOW_REQUEST_THRESHOLD_MS=1000
SLOW_QUERY_THRESHOLD_MS=500

REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
EXPOSE_ERROR_DETAILS=true

REQUIRE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# RedPA v4.2 Production Agentic AI
MODEL_GATEWAY_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MODEL_GATEWAY_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MODEL_GATEWAY_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_GATEWAY_FALLBACK_PROVIDERS=anthropic,openai,gemini,ollama
# Optional economics registry used by cost-aware routing.
# MODEL_GATEWAY_ECONOMICS_JSON={"openai:gpt-4.1-mini":{"input_per_1k":0.0,"output_per_1k":0.0,"quality_tier":2,"latency_tier":2}}
